#. Plugin Name of the plugin
#: external-files-from-webdav.php
msgid "External files from WebDav in Media Library"
msgstr "Externe Dateien aus WebDav in der Mediathek"

#. Description of the plugin
#: external-files-from-webdav.php
msgid "Extends External files in Media Library for use with WebDav."
msgstr ""
"Erweitert Externe Dateien in der Mediathek für die Verwendung von WebDav."

#. Author of the plugin
#: external-files-from-webdav.php
msgid "Thomas Zwirner"
msgstr "Thomas Zwirner"

#. Author URI of the plugin
#: external-files-from-webdav.php
msgid "https://www.thomaszwirner.de"
msgstr "https://www.thomaszwirner.de"

#: app/Plugin/Configuration.php:40
msgid "Use only WebDav"
msgstr "Verwende nur WebDav"

#: app/Plugin/Configuration.php:50
msgid "This will disable all other services except WebDav."
msgstr "Dadurch werden alle anderen Dienste außer WebDAV deaktiviert."

#: app/Plugin/Configuration.php:50
msgid ""
"After that, you will only be able to see and use WebDav for external sources."
msgstr ""
"Danach können Sie WebDAV nur noch für externe Quellen anzeigen und nutzen."

#: app/WebDav.php:119
msgid "Choose file(s) from your WebDAV"
msgstr "Wähle Datei(en) von deinem WebDav"

#: app/WebDav.php:192 app/WebDav.php:709
msgid "WebDAV Server"
msgstr "WebDAV Server"

#: app/WebDav.php:193 app/WebDav.php:711
msgid "https://nextcloud.local"
msgstr "https://nextcloud.local"

#: app/WebDav.php:204 app/WebDav.php:714 app/WebDav.php:764
msgid "Login"
msgstr "Login"

#: app/WebDav.php:205 app/WebDav.php:716 app/WebDav.php:765
msgid "Your login"
msgstr "Dein Login"

#: app/WebDav.php:216 app/WebDav.php:719 app/WebDav.php:773
msgid "Password"
msgstr "Passwort"

#: app/WebDav.php:217 app/WebDav.php:721 app/WebDav.php:774
msgid "Your password"
msgstr "Dein Passwort"

#: app/WebDav.php:226 app/WebDav.php:724 app/WebDav.php:782
msgid "Path"
msgstr "Pfad"

#: app/WebDav.php:227 app/WebDav.php:726
msgid ""
"Define the path added after the WebDAV-domain to load files. For Nextcloud-"
"based WebDAV this is <code>/remote.php/dav/files/</code>."
msgstr ""
"Gibt den Pfad nach der WebDav-Domain an um Dateien zu laden. Für Nextcloud-"
"basiertes WebDAV ist das <code>/remote.php/dav/files/</code>."

#: app/WebDav.php:238
msgid "Hint"
msgstr "Hinweis"

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:240
#, php-format
msgid ""
"Each user will find its settings in his own <a href=\"%1$s\">user profile</"
"a>."
msgstr ""
"Jeder Benutzer findet seine Einstellungen in seinem eigenem <a "
"href=\"%1$s\">Benutzerprofil</a>."

#: app/WebDav.php:250
msgid "Ignore self-signed SSL-certificates"
msgstr "Ignoriere selbst signierte SSL-Zertifikate"

#: app/WebDav.php:251
msgid "If enabled self-signed certificates will be acknowledged."
msgstr "Wenn aktiviert werden selbst signierte SSL-Zertifikate angenommen."

