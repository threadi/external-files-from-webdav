msgstr "https://nextcloud.local"

#: app/WebDav.php:211 app/WebDav.php:220 app/WebDav.php:814 app/WebDav.php:864
msgid "Login"
msgstr "Login"

#: app/WebDav.php:221 app/WebDav.php:816 app/WebDav.php:865
msgid "Your login"
msgstr "Dein Login"

#: app/WebDav.php:226 app/WebDav.php:235 app/WebDav.php:819 app/WebDav.php:873
msgid "Password"
msgstr "Passwort"

#: app/WebDav.php:236 app/WebDav.php:821 app/WebDav.php:874
msgid "Your password"
msgstr "Dein Passwort"

#: app/WebDav.php:241 app/WebDav.php:248 app/WebDav.php:824 app/WebDav.php:882
msgid "Path"
msgstr "Pfad"

#: app/WebDav.php:249 app/WebDav.php:826
msgid "Define the path added after the WebDAV-domain to load files. For Nextcloud-based WebDAV this is <code>/remote.php/dav/files/</code>."
msgstr "Gibt den Pfad nach der WebDav-Domain an um Dateien zu laden. Für Nextcloud-basiertes WebDAV ist das <code>/remote.php/dav/files/</code>."

#: app/WebDav.php:261
msgid "Hint"
msgstr "Hinweis"

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:263
#, php-format
msgid "Each user will find its settings in his own <a href=\"%1$s\">user profile</a>."
msgstr "Jeder Benutzer findet seine Einstellungen in seinem eigenem <a href=\"%1$s\">Benutzerprofil</a>."

#: app/WebDav.php:273
msgid "Ignore self-signed SSL-certificates"
msgstr "Ignoriere selbst signierte SSL-Zertifikate"

#: app/WebDav.php:274
msgid "If enabled self-signed certificates will be acknowledged."
msgstr "Wenn aktiviert werden selbst signierte SSL-Zertifikate angenommen."

