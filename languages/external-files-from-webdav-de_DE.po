msgstr "/remote.php/dav/files/"

#: app/WebDav.php:970
msgid "Connect to your WebDAV"
msgstr "Verbinde zu deinem WebDAV"

#: app/WebDav.php:974
msgid "Enter your credentials"
msgstr "Gibt deine Zugangsdaten ein"

#: app/WebDav.php:989
msgid "The credentials have already been set by an administrator in the plugin settings. Just connect for show the files."
msgstr "Ein Zugriffstoken wurde bereits von einem Administrator in den Plugin-Einstellungen festgelegt. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#: app/WebDav.php:993
msgid "The credentials must be set by an administrator in the plugin settings."
msgstr "Die Zugangsdaten müssen von einem Administrator in den Plugin-Einstellungen festgelegt werden."

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:998
#, php-format
msgid "Set your credentials <a href=\"%1$s\">here</a>."
msgstr "Lege deine Zugangsdaten <a href=\"%1$s\">hier</a> fest."

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:1002
#, php-format
msgid "Your credentials are already set <a href=\"%1$s\">here</a>. Just connect for show the files."
msgstr "Deine Zugangsdaten sind bereits <a href=\"%1$s\">hier</a> eingerichtet. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:1009
#, php-format
msgid "Set your credentials <a href=\"%1$s\">in your profile</a>."
msgstr "Lege deine Zugangsdaten <a href=\"%1$s\">in deinem Profil</a> fest."

#. translators: %1$s will be replaced by a URL.
#: app/WebDav.php:1013
#, php-format
msgid "Your credentials are already set <a href=\"%1$s\">in your profile</a>. Just connect for show the files."
msgstr "Dein Zugriffstoken ist bereits <a href=\"%1$s\">in deinem Profil</a> festgelegt. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#: app/WebDav.php:1016
msgid "Enter your WebDAV credentials in this form."
msgstr "Gibt die Zugangsdaten zu deinem WebDAV in dem Formular ein."

#: app/WebDav.php:1187
msgid "No credentials set for this WebDAV connection!"
msgstr "Für diese WebDAV-Verbindung sind keine Zugangsdaten hinterlegt!"

#: app/WebDav.php:1234
msgid "The directory could not be read on WebDAV. Error:"
msgstr "Das Verzeichnis konnte auf WebDAV nicht gelesen werden. Fehler:"

#: app/WebDav.php:1235
msgid "The directory could not be read on WebDAV. Check the server, the path and the credentials."
msgstr "Das Verzeichnis konnte auf WebDAV nicht gelesen werden. Prüfe Server, Pfad und Zugangsdaten."

#: app/WebDav.php:1239
msgid "The directory could be read."
msgstr "Das Verzeichnis konnte gelesen werden."

#: app/WebDav.php:1261
msgid "The test file could not be uploaded to WebDAV. Error:"
msgstr "Die Testdatei konnte nicht auf WebDAV hochgeladen werden. Fehler:"

#: app/WebDav.php:1262
msgid "The test file could not be uploaded to WebDAV. Check the permissions of the directory."
msgstr "Die Testdatei konnte nicht auf WebDAV hochgeladen werden. Prüfe die Berechtigungen des Verzeichnisses."

#. translators: %1$d will be replaced by an HTTP status like 403.
#: app/WebDav.php:1268
#, php-format
msgid "The test file could not be uploaded to WebDAV. The server returns with HTTP status %1$d."
msgstr "Die Testdatei konnte nicht auf WebDAV hochgeladen werden. Der Server antwortet mit dem HTTP-Status %1$d."

#: app/WebDav.php:1294
msgid "The test file could not be deleted on WebDAV. Error:"
msgstr "Die Testdatei konnte auf WebDAV nicht gelöscht werden. Fehler:"

#: app/WebDav.php:1295 app/WebDav.php:1300
msgid "The test file could not be deleted on WebDAV."
msgstr "Die Testdatei konnte auf WebDAV nicht gelöscht werden."

#: app/WebDav/Export.php:113
msgid "Could not load file path for given attachment ID."
msgstr "Der Dateipfad für die angegebene Anhang-ID konnte nicht geladen werden."

#: app/WebDav/Export.php:125
msgid "Given file does not exist:"
msgstr "Die angegebene Datei existiert nicht:"

#: app/WebDav/Export.php:146
msgid "Given file could not be opened for the export:"
msgstr "Die Datei konnte für den Export nicht geöffnet werden:"

#: app/WebDav/Export.php:157
msgid "Error occurred during request to export a file to WebDav:"
msgstr "Beim Versuch, eine Datei nach WebDAV zu exportieren, ist ein Fehler aufgetreten:"

#: app/WebDav/Export.php:176
msgid "Got unsupported status code from WebDav during export of a file:"
msgstr "Erhielte einen nicht unterstützten Status Code von WebDAV beim Exportieren einer Datei:"

#: app/WebDav/Export.php:245
msgid "Error occurred during request to delete a file on WebDav:"
msgstr "Fehler beim Löschen einer Datei vom WebDAV:"

#: app/WebDav/Export.php:262
msgid "Got unsupported status code from WebDav during deletion of a file:"
msgstr "Erhielt nicht unterstützten Status Code von WebDav während dem Löschen einer Datei:"

#: app/WebDav/Export.php:351 app/WebDav/Export.php:357
msgid "Error occurred during request to create a folder on WebDav:"
msgstr "Beim Anlegen eines Ordners auf WebDAV ist ein Fehler aufgetreten:"

#: app/WebDav/Export.php:366
msgid "Got unsupported status code from WebDav during creation of a folder:"
msgstr "WebDAV hat beim Anlegen eines Ordners mit einem nicht unterstützten Statuscode geantwortet:"

#: app/WebDav/Protocol.php:118 app/WebDav/Protocol.php:357
msgid "Got faulty URL."
msgstr "Erhielt fehlerhafte URL."

#: app/WebDav/Protocol.php:177 app/WebDav/Protocol.php:414
msgid "Error occurred during requesting the directory listing."
msgstr "Beim Abrufen der Anmeldedatei für Google Cloud Storage ist ein Fehler aufgetreten."

#: app/WebDav/Protocol.php:191 app/WebDav/Protocol.php:432
msgid "Got empty response from WebDAV for given file."
msgstr "Erhielt leere Antwort von WebDAV zur angegebenen Datei."

#: app/WebDav/Protocol.php:244
msgid "The given file already exist in your media library."
msgstr "Die angegebene Datei existiert bereits in deiner Mediathek."

#: app/WebDav/Protocol.php:323
#, php-format
msgid "%1$d file could not be loaded during WebDAV import:<br><br>%2$s"
msgid_plural "%1$d files could not be loaded during WebDAV import:<br><br>%2$s"
msgstr[0] "%1$d Datei konnte beim WebDAV-Import nicht geladen werden: <br><br>%2$s"
msgstr[1] "%1$d Dateien konnten beim WebDAV-Import nicht geladen werden: <br><br>%2$s"

#: app/WebDav/Protocol.php:547
msgid "File could not be loaded from WebDAV:"
msgstr "Die Datei konnte nicht von WebDAV geladen werden:"
